# LLM Provider: 'groq' (recommended, free) or 'ollama' (local)
LLM_PROVIDER=groq

# Groq API Key (get free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Model names
GROQ_MODEL=qwen-qwq-32b
OLLAMA_MODEL=gemma2:9b

# Search settings
MAX_SEARCH_RESULTS=10
MAX_ARXIV_RESULTS=5

# Scraper settings
SCRAPE_TIMEOUT=10
